{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agileforge-api": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm ci"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "agileforge-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
